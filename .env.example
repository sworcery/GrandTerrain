# Root-stack settings for `docker compose up` (web + worker).
# Copy to `.env` next to docker-compose.yml — Docker Compose auto-loads ./.env.
# Every value here is optional; the defaults below match docker-compose.yml.

# ---- Ports (host side; container ports are fixed at 8080 / 3000) ----
WORKER_PORT=8080
WEB_PORT=3000

# ---- Worker ----
# Allowed CORS origins for the worker API (comma-separated, or * for any).
CORS_ORIGINS=*
# Generation jobs allowed at once. Keep at 1: the job slot is in-memory and
# assumes a single uvicorn process; each job also needs ~8 GB RAM.
MAX_CONCURRENT_JOBS=1
# Age in hours after which finished job dirs and world zips are deleted.
JOB_RETENTION_HOURS=24
# Max heap for the generation JVM. 1024-tall chunks are memory-hungry; 2G
# reproducibly OOMs at the default radius. Host needs ~8 GB free for 6G.
SERVER_MEMORY=6G
# Pre-generation radius in blocks from spawn (2000 = a 4000x4000 area); 0 disables.
PREGEN_RADIUS=2000
# Hard cap on pre-generation time in seconds; partial pre-gen is still packaged.
PREGEN_TIMEOUT=21600
# Refuse to start a job if the data volume has less than this many GB free
# (a default-radius job needs ~5 GB while the world tree and zip coexist).
MIN_FREE_DISK_GB=5

# ---- Web ----
# Worker URL as seen from the BROWSER. Normally NOT needed: the web UI proxies
# worker calls same-origin at /worker, so leave this unset. Only set it if you
# want the browser to talk to the worker directly (e.g. a LAN IP), and note it
# is BAKED INTO THE WEB BUNDLE AT BUILD TIME — changing it requires
# `docker compose up --build`, not just a restart.
#NEXT_PUBLIC_WORKER_URL=http://<host>:8080
